---
import {
  type CalendarEvent,
  createJstDate,
  formatLocalDate,
  getJstDateKey,
  getJstDateNumber,
  getJstDaysInMonth,
  getJstMonth,
  getJstMonthName,
  getJstWeekday,
  getJstYear,
  getTodayInJst,
  isSameJstDay,
  formatEventTime,
  getEventDateRange,
  isMultiDayEvent,
} from "@/composables/useCalendar";
import { getCalendarEventsJson } from "@/server/calendar";
type Props = {
  year: number;
  month: number;
  prevHref?: string | null;
  nextHref?: string | null;
};

const { year, month, prevHref = null, nextHref = null } = Astro.props;
const currentYear = year;
const currentMonth = month;
const start = createJstDate(currentYear, currentMonth, 1);
const end = createJstDate(currentYear, currentMonth + 1, 0);

async function getCalendarEventsOnServer(
  startDate: Date,
  endDate: Date,
): Promise<CalendarEvent[]> {
  const start = formatLocalDate(startDate);
  const end = formatLocalDate(endDate);
  return await getCalendarEventsJson({
    start,
    end,
  });
}

let events: CalendarEvent[] = [];
let loadError: string | null = null;

try {
  events = await getCalendarEventsOnServer(start, end);
} catch (error) {
  loadError = error instanceof Error ? error.message : "エラーが発生しました";
}

function dateKey(date: Date): string {
  return getJstDateKey(date);
}

function getEventBadgeClass(title: string): string {
  if (title.includes("中百舌鳥")) return "event-nakamozu";
  if (title.includes("杉本")) return "event-sugimoto";
  if (title.includes("森之宮")) return "event-morinomiya";
  if (title.includes("会")) return "event-event";
  return "event-default";
}

function isStartDay(event: CalendarEvent, date: Date): boolean {
  const startDate = new Date(event.start);
  return isSameJstDay(startDate, date);
}

function isToday(date: Date): boolean {
  return isSameJstDay(date, getTodayInJst());
}

function getEventAnimationDelay(
  allEvents: CalendarEvent[],
  event: CalendarEvent,
): number {
  const index = allEvents.findIndex((candidate) => candidate.id === event.id);
  return index >= 0 ? index * 30 : 0;
}

function getCalendarDays(year: number, month: number): (Date | null)[] {
  const days: (Date | null)[] = [];
  const firstDayOfMonth = getJstWeekday(year, month, 1);
  const daysInMonth = getJstDaysInMonth(year, month);

  for (let index = 0; index < firstDayOfMonth; index += 1) {
    days.push(null);
  }

  for (let day = 1; day <= daysInMonth; day += 1) {
    days.push(createJstDate(year, month, day));
  }

  const remainingCells = (7 - (days.length % 7)) % 7;
  for (let index = 0; index < remainingCells; index += 1) {
    days.push(null);
  }

  return days;
}

function buildEventsByDate(
  allEvents: CalendarEvent[],
): Map<string, CalendarEvent[]> {
  const result = new Map<string, CalendarEvent[]>();

  allEvents.forEach((event) => {
    const { startDate, endDate } = getEventDateRange(event);
    const current = createJstDate(
      getJstYear(startDate),
      getJstMonth(startDate),
      getJstDateNumber(startDate),
    );
    const end = createJstDate(
      getJstYear(endDate),
      getJstMonth(endDate),
      getJstDateNumber(endDate),
    );

    while (current <= end) {
      const key = dateKey(current);
      const existing = result.get(key) ?? [];
      existing.push(event);
      result.set(key, existing);
      current.setTime(current.getTime() + 24 * 60 * 60 * 1000);
    }
  });

  return result;
}

const calendarDays = getCalendarDays(currentYear, currentMonth);
const eventsByDate = buildEventsByDate(events);
const monthName = getJstMonthName(currentYear, currentMonth);
---

<div>
  {loadError && <div class="text-error">{loadError}</div>}

  <div
    id="calendar-grid"
    class="calendar-container overflow-hidden"
    role="grid"
    aria-labelledby="cal-title"
  >
    <h2 id="cal-title" class="h2 mb-4 flex items-center justify-between">
      {
        prevHref ? (
          <a
            class="p-2 hover:bg-zinc-200 dark:hover:bg-zinc-700 rounded"
            aria-label="前の月"
            href={prevHref}
          >
            <div class="i-ri:arrow-left-s-line h-5 w-5" />
          </a>
        ) : (
          <span
            class="p-2 rounded opacity-30 cursor-not-allowed"
            aria-label="前の月"
            aria-disabled="true"
          >
            <div class="i-ri:arrow-left-s-line h-5 w-5" />
          </span>
        )
      }
      <span>{monthName}</span>
      {
        nextHref ? (
          <a
            class="p-2 hover:bg-zinc-200 dark:hover:bg-zinc-700 rounded"
            aria-label="次の月"
            href={nextHref}
          >
            <div class="i-ri:arrow-right-s-line h-5 w-5" />
          </a>
        ) : (
          <span
            class="p-2 rounded opacity-30 cursor-not-allowed"
            aria-label="次の月"
            aria-disabled="true"
          >
            <div class="i-ri:arrow-right-s-line h-5 w-5" />
          </span>
        )
      }
    </h2>

    <div class="grid grid-cols-7 mb-2" role="row">
      {
        ["日", "月", "火", "水", "木", "金", "土"].map((day) => (
          <div
            role="columnheader"
            class:list={[
              "text-sm font-semibold text-center",
              day === "日" && "text-red-500",
              day === "土" && "text-blue-500",
              day !== "日" && day !== "土" && "fg-base",
            ]}
          >
            {day}
          </div>
        ))
      }
    </div>

    <div class="grid grid-cols-7 gap-1" role="rowgroup">
      {
        calendarDays.map((date) => (
          <div
            role="gridcell"
            class:list={[
              "min-h-24 rounded-sm p-1 border bg-zinc-200/20 dark:bg-zinc-800/20",
              !date && "opacity-60 bordered-muted",
              date && isToday(date) && "bordered-accent print:bordered-muted",
              date && !isToday(date) && "bordered-muted",
            ]}
          >
            {date && (
              <>
                <time
                  class="text-xs font-semibold ml-1 fg-base"
                  datetime={formatLocalDate(date)}
                >
                  {getJstDateNumber(date)}
                </time>

                <ul class="mt-1 space-y-1">
                  {(eventsByDate.get(dateKey(date)) ?? []).map((event) => (
                    <li
                      class:list={[
                        "rounded px-1 py-0.5 text-[11px] leading-tight stagger-item",
                        getEventBadgeClass(event.title),
                      ]}
                      title={`${event.title} ${formatEventTime(event.start)}${event.end ? ` - ${formatEventTime(event.end)}` : ""}`}
                      style={`animation-delay: ${getEventAnimationDelay(events, event)}ms;`}
                    >
                      <span class="truncate block">{event.title}</span>
                      {isStartDay(event, date) && !isMultiDayEvent(event) && (
                        <time class="block mt-0.5 text-[10px] opacity-80">
                          {formatEventTime(event.start)}
                        </time>
                      )}
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        ))
      }
    </div>
  </div>
</div>

<style scoped>
  .calendar-container {
    container-type: inline-size;
  }

  .stagger-item {
    animation: fadeSlideIn 0.4s ease both;
  }

  @media (prefers-reduced-motion: reduce) {
    .stagger-item {
      animation: none;
    }
  }

  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateX(4px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
