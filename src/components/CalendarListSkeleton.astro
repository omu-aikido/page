---
const skeletonItems = Array.from({ length: 6 }, (_, index) => index);
---

<div
  class="divide-y divide-zinc-200/70 dark:divide-zinc-700/70"
  aria-hidden="true"
  data-calendar-list-skeleton
>
  {
    skeletonItems.map((item, index) => (
      <div
        class="stagger-item px-4 py-5 min-w-0 grid grid-flow-col grid-cols-2 sm:grid-cols-[1fr_2fr]"
        style={`animation-delay: ${index * 60}ms;`}
      >
        <h3 class="font-semibold text-lg">
          <div
            class:list={[
              "skeleton-item h-1em rounded bg-zinc-200 dark:bg-zinc-800",
              index % 3 !== 0 ? "w-4em" : "w-3em",
            ]}
          />
        </h3>

        <div class="space-y-2 text-sm fg-muted">
          <div class="inline-flex items-center gap-2">
            <div class="skeleton-item h-4 w-1em rounded bg-zinc-200 dark:bg-zinc-800" />
            <div class="skeleton-item h-4 w-6em rounded bg-zinc-200 dark:bg-zinc-800" />
          </div>
          <div class="inline-flex items-center gap-2">
            <div class="skeleton-item h-4 w-1em rounded bg-zinc-200 dark:bg-zinc-800" />
            <div class="skeleton-item h-4 w-8em rounded bg-zinc-200 dark:bg-zinc-800" />
          </div>
        </div>
      </div>
    ))
  }
</div>

<style scoped>
  .stagger-item {
    animation: fadeSlideIn 0.4s ease both;
  }

  @media (prefers-reduced-motion: reduce) {
    .stagger-item,
    .skeleton-item {
      animation: none;
    }
  }

  @keyframes shimmer {
    0% {
      background-position: -1000px 0;
    }
    100% {
      background-position: 1000px 0;
    }
  }

  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .skeleton-item {
    background-image: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.1),
      transparent
    );
    background-size: 200px 100%;
    animation: shimmer 4s infinite;
  }
</style>
