---
const {
  src,
  class: iframeClass = "iframe-base",
  loading = "lazy",
  allowFullScreen = true,
  title = "Embedded content",
} = Astro.props;
---

<div class="iframe-wrapper rounded-lg overflow-hidden border bordered-muted aspect-[16/9]">
  <iframe
    src={src}
    title={title}
    loading={loading}
    class={`relative ${iframeClass}`}
    {...allowFullScreen ? { allowfullscreen: true } : {}}></iframe>
</div>
