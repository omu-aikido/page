---
export const prerender = true;
import CalendarList from "@/components/CalendarList.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="稽古予定" description="今後の稽古予定">
  <section class="container min-h-60dvh">
    <div class="mb-6" transition:name="calendar-head">
      <h1 class="h1">稽古予定</h1>
    </div>

    <CalendarList server:defer />

  </section>
  <section class="container">
    <p class="text-right mt-4">
      <a href="/calendar/monthly" class="text-lg link">1ヶ月ごとの予定</a>
    </p>
    <div
      id="google-calendar-navigation"
      class="card mt-4 flex items-start gap-3"
    >
      <center>
        <p>
          <a
            href="https://calendar.google.com/calendar/embed?src=aikido.omu%40gmail.com"
            target="_blank"
            rel="noopener noreferrer"
            class="link"
          >
            Googleカレンダー
          </a>
          では過去の稽古や1ヶ月以上先の稽古予定も確認できます。
        </p>
        <p>
          <a
            href="https://calendar.google.com/calendar/ical/aikido.omu%40gmail.com/public/basic.ics"
            target="_blank"
            rel="noopener noreferrer"
            class="link"
          >
            こちら
          </a>
          からご自身のスマートフォン・PCにこのカレンダーを追加可能です。
        </p>
      </center>
    </div>
  </section>
</Layout>
